{
	"name": "tetris-trainer",
	"author": "Matt Cavender",
	"license": "MIT",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24",
		"npm": ">=12"
	},
	"packageManager": "npm@12.0.1",
	"scripts": {
		"prepare": "node -e \"const c=require('node:child_process');if(c.spawnSync('git',['rev-parse','--is-inside-work-tree'],{stdio:'ignore'}).status===0)c.execFileSync('git',['config','core.hooksPath','.githooks'])\" && node tools.mjs install",
		"fix": "concurrently -m 1 --group \"prettier --write .\" \"eslint *.mjs --fix --cache\" \"turbo fix\" \"markdownlint-cli2 --fix \\\"**/*.md\\\"\"",
		"check": "concurrently --group \"prettier --check .\" \"eslint *.mjs --no-cache -f unix\" \"turbo check\" \"markdownlint-cli2 \\\"**/*.md\\\"\" \"knip --no-progress\" \"jscpd .\" \"check-dependency-version-consistency\" \"node tools.mjs run actionlint\"",
		"unit": "turbo unit",
		"build": "turbo build",
		"integration": "turbo integration",
		"start": "turbo start"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"devDependencies": {
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "9.39.5",
		"@html-eslint/eslint-plugin": "0.65.0",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "26.4.1",
		"check-dependency-version-consistency": "^6.0.0",
		"concurrently": "10.0.6",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-formatter-unix": "9.0.1",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-barrel-files": "3.0.1",
		"eslint-plugin-comment-rules": "0.1.7",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.12.0",
		"jscpd": "5.1.2",
		"knip": "6.34.0",
		"markdownlint-cli2": "0.24.0",
		"prettier": "3.9.6",
		"stylelint": "17.15.0",
		"stylelint-config-recommended": "18.0.0",
		"turbo": "^2.9.6",
		"typescript": "5.9.3",
		"typescript-eslint": "8.69.0",
		"vitest": "5.0.5"
	},
	"allowScripts": {
		"unrs-resolver@1.12.2": true,
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true,
		"electron-winstaller@5.4.0": true
	},
	"overrides": {
		"esbuild@^0.27": "^0.28.1",
		"re2js": "2.8.7"
	}
}
