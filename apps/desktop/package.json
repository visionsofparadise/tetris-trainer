{
	"name": "@tetris-trainer/desktop",
	"author": "Matt Cavender",
	"license": "MIT",
	"productName": "Tetris Trainer",
	"version": "0.1.0",
	"description": "Desktop Tetris with TETR.IO handling.",
	"private": true,
	"type": "module",
	"main": ".vite/build/main.cjs",
	"scripts": {
		"start": "electron-forge start",
		"build": "node tools/build.mjs",
		"check": "concurrently --group \"eslint . --no-cache -f unix\" \"tsc --noEmit --pretty false\" \"stylelint \\\"**/*.css\\\" -f unix --allow-empty-input --cache\"",
		"fix": "concurrently -m 1 --group \"eslint . --fix --cache\" \"stylelint \\\"**/*.css\\\" --fix --allow-empty-input --cache\"",
		"unit": "vitest run unit --passWithNoTests",
		"integration": "vitest run integration"
	},
	"dependencies": {
		"@fontsource-variable/anybody": "5.3.0",
		"@fontsource-variable/archivo": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@pixi/react": "8.0.5",
		"@tetris-trainer/game": "*",
		"clsx": "2.1.1",
		"events": "3.3.0",
		"opshot": "0.6.1",
		"pixi.js": "8.23.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "3.7.0"
	},
	"devDependencies": {
		"@electron-forge/cli": "8.0.1",
		"@electron-forge/plugin-fuses": "8.0.1",
		"@electron-forge/plugin-vite": "8.0.1",
		"@electron-forge/shared-types": "8.0.1",
		"@electron/fuses": "2.1.3",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "6.1.1",
		"electron": "44.10.1",
		"electron-builder": "26.15.3",
		"tailwindcss": "4.3.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
