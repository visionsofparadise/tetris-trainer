{
	"name": "@monorepo-starter/library",
	"license": "MIT",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"fix": "eslint . --fix --cache",
		"check": "concurrently --group \"eslint . --no-cache -f unix\" \"tsc --noEmit --pretty false\"",
		"unit": "vitest run",
		"build": "tsup src/index.ts --format esm --dts --treeshake --clean"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"vitest": "^4.1.10",
		"@types/node": "^24.0.0"
	}
}
