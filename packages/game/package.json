{
	"name": "@tetris-trainer/game",
	"license": "MIT",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"fix": "eslint . --fix --cache",
		"check": "concurrently --group \"eslint . --no-cache -f unix\" \"tsc --noEmit --pretty false\"",
		"unit": "vitest run unit",
		"integration": "vitest run integration",
		"build": "tsup src/index.ts --format esm --dts --treeshake --clean"
	},
	"dependencies": {
		"@haelp/teto": "4.2.8",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"tsup": "8.5.1"
	}
}
