{
	"minLines": 5,
	"minTokens": 50,
	"gitignore": true,
	"absolute": true,
	"threshold": 0,
	"format": ["javascript", "typescript", "tsx", "css", "markup"],
	"reporters": ["console"],
	"ignore": [
		"**/.*/**",
		"**/*.md",
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/__fixtures__/**",
		"**/designs/**",
		"**/types/*.d.ts",
		"**/package.json",
		"package-lock.json"
	]
}
